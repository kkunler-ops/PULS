# Resend (https://resend.com) — Free-Plan reicht fürs MVP
RESEND_API_KEY=re_xxxxxxxxx

# Für Tests ohne eigene Domain: PULS <onboarding@resend.dev>
# (geht nur an die E-Mail deines Resend-Accounts)
# Für echte Notfall-Mails: verifizierte Domain, z. B. PULS <noreply@deinedomain.de>
RESEND_FROM_EMAIL=PULS <onboarding@resend.dev>

# Twilio — optionale Alarm-SMS (Keys nur in Vercel, nie committen)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+49xxxxxxxxxx
# Optional: vorhandener Messaging Service. Fehlt er, legt die API einen an.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# Im Twilio-Trial sind nur Template-Bodies erlaubt (sms_account_alerts, …).
# Die API fällt automatisch darauf zurück, bis das Konto upgraded ist.

# PostHog (EU) — Project API Key aus Project Settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
